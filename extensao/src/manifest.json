{
  "manifest_version": 3,
  "name": "Oceano Lite",
  "version": "0.1.0",
  "description": "Nova aba pixel art com mar em dither, temas .oceano e mods em Lua, a linguagem criada na PUC-Rio. Sem telemetria.",
  "chrome_url_overrides": { "newtab": "novaaba.html" },
  "permissions": ["search"],
  "icons": { "16": "icones/16.png", "32": "icones/32.png", "48": "icones/48.png", "128": "icones/128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
